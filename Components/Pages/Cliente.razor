@page "/cliente"
@rendermode InteractiveServer
@inject HttpClient Http
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations

<PageTitle>Gestión de Clientes</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Clientes</h2>
        <button class="btn btn-primary" @onclick="AbrirModalNuevo">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Cliente
        </button>
    </div>

    @if (cargando)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2">Cargando información del API...</p>
        </div>
    }
    else if (clientesList == null || !clientesList.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            No se encontraron registros de clientes.
        </div>
    }
    else
    {
        <!-- Tabla HTML con los registros paginados (Sin mostrar Id_cliente) -->
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>CUI</th>
                        <th>NIT</th>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Dirección</th>
                        <th>Teléfono</th>
                        <th>Fecha de Nacimiento</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cliente in pagedClientes)
                    {
                        <tr>
                            <td>@cliente.cui</td>
                            <td>@cliente.nit</td>
                            <td>@cliente.nombres</td>
                            <td>@cliente.apellidos</td>
                            <td>@cliente.direccion</td>
                            <td>@cliente.telefono</td>
                            <td>@(cliente.fecha_nacimiento.HasValue? cliente.fecha_nacimiento.Value.ToString("dd/MM/yyyy") :
          "")</td>
                                <td class="text-center">
                                    <button class="btn btn-warning btn-sm me-1" @onclick="() => AbrirModalEditar(cliente)">
                                        Editar
                                    </button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => ConfirmarEliminar(cliente.Id_cliente)">
                                        Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginación -->
            <div class="d-flex justify-content-between align-items-center mt-3">
                <span>Mostrando página @currentPage de @totalPages (Total: @clientesList.Count registros)</span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => CambiarPagina(currentPage - 1)">Anterior</button>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            int pageNumber = i;
                            <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                <button class="page-link" @onclick="() => CambiarPagina(pageNumber)">@pageNumber</button>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => CambiarPagina(currentPage + 1)">Siguiente</button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>

    <!-- Ventana Modal de Formulario con Validaciones Bootstrap -->
    @if (mostrarModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" aria-modal="true"
             role="dialog">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title">@(esEdicion ? "Editar Cliente" : "Nuevo Cliente")</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                    </div>

                    <EditForm Model="clienteForm" OnValidSubmit="GuardarCliente">
                        <DataAnnotationsValidator />

                        <div class="modal-body">
                            <div class="row g-3">
                                <!-- CUI -->
                                <div class="col-md-6">
                                    <label class="form-label font-weight-bold">CUI <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="clienteForm.cui"
                                               placeholder="Ej: 1234567890101" />
                                    <div class="text-danger small mt-1">
                                        <ValidationMessage For="@(() => clienteForm.cui)" />
                                    </div>
                                </div>

                                <!-- NIT -->
                                <div class="col-md-6">
                                    <label class="form-label">NIT <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="clienteForm.nit" placeholder="Ej: 1234567-K" />
                                    <div class="text-danger small mt-1">
                                        <ValidationMessage For="@(() => clienteForm.nit)" />
                                    </div>
                                </div>

                                <!-- Nombres -->
                                <div class="col-md-6">
                                    <label class="form-label">Nombres <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="clienteForm.nombres"
                                               placeholder="Ingrese nombres" />
                                    <div class="text-danger small mt-1">
                                        <ValidationMessage For="@(() => clienteForm.nombres)" />
                                    </div>
                                </div>

                                <!-- Apellidos -->
                                <div class="col-md-6">
                                    <label class="form-label">Apellidos <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="clienteForm.apellidos"
                                               placeholder="Ingrese apellidos" />
                                    <div class="text-danger small mt-1">
                                        <ValidationMessage For="@(() => clienteForm.apellidos)" />
                                    </div>
                                </div>

                                <!-- Dirección -->
                                <div class="col-md-12">
                                    <label class="form-label">Dirección <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="clienteForm.direccion"
                                               placeholder="Ingrese dirección completa" />
                                    <div class="text-danger small mt-1">
                                        <ValidationMessage For="@(() => clienteForm.direccion)" />
                                    </div>
                                </div>

                                <!-- Teléfono -->
                                <div class="col-md-6">
                                    <label class="form-label">Teléfono <span class="text-danger">*</span></label>
                                    <InputText class="form-control" @bind-Value="clienteForm.telefono"
                                               placeholder="Ej: 55551234" />
                                    <div class="text-danger small mt-1">
                                        <ValidationMessage For="@(() => clienteForm.telefono)" />
                                    </div>
                                </div>

                                <!-- Fecha de Nacimiento -->
                                <div class="col-md-6">
                                    <label class="form-label">Fecha de Nacimiento <span class="text-danger">*</span></label>
                                    <InputDate class="form-control" @bind-Value="clienteForm.fecha_nacimiento" />
                                    <div class="text-danger small mt-1">
                                        <ValidationMessage For="@(() => clienteForm.fecha_nacimiento)" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn btn-success" disabled="@enviando">
                                @(esEdicion ? "Actualizar" : "Guardar")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    }

    <!-- Ventana Modal de Confirmación para Eliminar -->
    @if (mostrarModalEliminar)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" aria-modal="true"
             role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">Confirmar Eliminación</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalEliminar"></button>
                    </div>
                    <div class="modal-body">
                        <p>¿Está seguro de que desea eliminar este cliente? Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModalEliminar">Cancelar</button>
                        <button type="button" class="btn btn-danger" @onclick="EliminarCliente">Eliminar</button>
                    </div>
                </div>
            </div>
        </div>
    }

@code {
    // Modelo de Clientes con Validaciones de Data Annotations
    public class ClientesModel
    {
        public int Id_cliente { get; set; }

        [Required(ErrorMessage = "El CUI es obligatorio.")]
        [RegularExpression(@"^[0-9]{13}$", ErrorMessage = "El CUI debe ser numérico y contener exactamente 13 dígitos.")]
        public string? cui { get; set; }

        [Required(ErrorMessage = "El NIT es obligatorio.")]
        public string? nit { get; set; }

        [Required(ErrorMessage = "Los nombres son obligatorios.")]
        [StringLength(100, ErrorMessage = "Los nombres no pueden superar los 100 caracteres.")]
        public string? nombres { get; set; }

        [Required(ErrorMessage = "Los apellidos son obligatorios.")]
        [StringLength(100, ErrorMessage = "Los apellidos no pueden superar los 100 caracteres.")]
        public string? apellidos { get; set; }

        [Required(ErrorMessage = "La dirección es obligatoria.")]
        public string? direccion { get; set; }

        [Required(ErrorMessage = "El teléfono es obligatorio.")]
        [RegularExpression(@"^[0-9]{8,15}$", ErrorMessage = "El teléfono debe contener entre 8 y 15 dígitos numéricos.")]
        public string? telefono { get; set; }

        [Required(ErrorMessage = "La fecha de nacimiento es obligatoria.")]
        public DateTime? fecha_nacimiento { get; set; }
    }

    private List<ClientesModel> clientesList = new();
    private ClientesModel clienteForm = new();
    
    private bool cargando = true;
    private bool enviando = false;
    private bool mostrarModal = false;
    private bool esEdicion = false;
    
    private bool mostrarModalEliminar = false;
    private int idClienteEliminar = 0;

    // Configuración de Paginación
    private int currentPage = 1;
    private int pageSize = 5;

    private IEnumerable<ClientesModel> pagedClientes => clientesList
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private int totalPages => (int)Math.Ceiling((double)clientesList.Count / pageSize);

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    // GET: Leer clientes
    private async Task CargarClientes()
    {
        cargando = true;
        try
        {
            var respuesta = await Http.GetFromJsonAsync<List<ClientesModel>>("api/Clientes");
            clientesList = respuesta ?? new List<ClientesModel>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al obtener clientes: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNuevo()
    {
        clienteForm = new ClientesModel
        {
            fecha_nacimiento = DateTime.Today
        };
        esEdicion = false;
        mostrarModal = true;
    }

    private void AbrirModalEditar(ClientesModel cliente)
    {
        clienteForm = new ClientesModel
        {
            Id_cliente = cliente.Id_cliente,
            cui = cliente.cui,
            nit = cliente.nit,
            nombres = cliente.nombres,
            apellidos = cliente.apellidos,
            direccion = cliente.direccion,
            telefono = cliente.telefono,
            fecha_nacimiento = cliente.fecha_nacimiento
        };
        esEdicion = true;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    // POST / PUT: Se ejecuta ÚNICAMENTE si el formulario pasa todas las validaciones
    private async Task GuardarCliente()
    {
        enviando = true;
        try
        {
            if (esEdicion)
            {
                var response = await Http.PutAsJsonAsync($"api/Clientes/{clienteForm.Id_cliente}", clienteForm);
                if (response.IsSuccessStatusCode)
                {
                    await CargarClientes();
                    CerrarModal();
                }
            }
            else
            {
                var response = await Http.PostAsJsonAsync("api/Clientes", clienteForm);
                if (response.IsSuccessStatusCode)
                {
                    await CargarClientes();
                    CerrarModal();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar cliente: {ex.Message}");
        }
        finally
        {
            enviando = false;
        }
    }

    private void ConfirmarEliminar(int id)
    {
        idClienteEliminar = id;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        idClienteEliminar = 0;
    }

    private async Task EliminarCliente()
    {
        try
        {
            var response = await Http.DeleteAsync($"api/Clientes/{idClienteEliminar}");
            if (response.IsSuccessStatusCode)
            {
                await CargarClientes();
                if (currentPage > totalPages && totalPages > 0)
                {
                    currentPage = totalPages;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al eliminar cliente: {ex.Message}");
        }
        finally
        {
            CerrarModalEliminar();
        }
    }

    private void CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina >= 1 && nuevaPagina <= totalPages)
        {
            currentPage = nuevaPagina;
        }
    }
}